{
  "openapi": "3.1.0",
  "info": {
    "title": "xsigner IPA Signing API",
    "version": "2.1.0",
    "description": "Async IPA signing via zsign and Tigris object storage. Documentation is owner-IP-only. Signing submissions remain public and source-IP rate-limited while API_CLIENTS_JSON is unset; when configured, X-API-Key becomes required and per-client quotas apply. Upload ipa or pass ipaUrl; p12 and mobileprovision are always files. JSON responses carry requestId and X-Request-ID. Remote HTTPS downloads pin validated DNS answers. Optional Redis/BullMQ mode enables shared worker queues, S3-backed manifests, and cross-instance client quotas."
  },
  "servers": [
    {
      "url": "https://xsigner.onrender.com"
    }
  ],
  "tags": [
    {
      "name": "Signing"
    },
    {
      "name": "Results"
    },
    {
      "name": "Health"
    }
  ],
  "paths": {
    "/healthz": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Render health check (alias of /health)",
        "responses": {
          "200": {
            "description": "Required runtime configuration exists.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "Required dependency missing.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        },
        "description": "Fast configuration readiness endpoint for Render. Returns X-Request-ID; see /healthz/dependencies for cached deeper diagnostics."
      }
    },
    "/sign": {
      "post": {
        "tags": [
          "Signing"
        ],
        "summary": "Submit an IPA signing job",
        "description": "Multipart signing submission. With API_CLIENTS_JSON unset, no API key is required and anonymous requests are source-IP rate-limited. If API_CLIENTS_JSON is configured, send X-API-Key; each configured client has an independent quota, plus an authenticated per-IP safety ceiling. Alias: /api/v1/discord/sign.",
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "type": "object",
                "properties": {
                  "ipa": {
                    "type": "string",
                    "format": "binary",
                    "description": "IPA file, mutually exclusive with ipaUrl; 4 GiB default limit."
                  },
                  "ipaUrl": {
                    "type": "string",
                    "format": "uri",
                    "description": "Public direct HTTPS download URL for IPA; signed/query-string links, extensionless download paths, and safe HTTPS redirects are supported. The URL must be reachable without interactive authentication; the only URL-valued input."
                  },
                  "p12": {
                    "type": "string",
                    "format": "binary",
                    "description": "Required .p12/.pfx certificate file; alias certificate."
                  },
                  "certificate": {
                    "type": "string",
                    "format": "binary",
                    "description": "Legacy alias for p12."
                  },
                  "mobileprovision": {
                    "type": "string",
                    "format": "binary",
                    "description": "Required mobileprovision file; alias profile."
                  },
                  "profile": {
                    "type": "string",
                    "format": "binary",
                    "description": "Legacy alias for mobileprovision."
                  },
                  "password": {
                    "type": "string",
                    "description": "P12 password; blank if unencrypted."
                  },
                  "icon": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional PNG app icon."
                  },
                  "deb": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional .deb tweak bundle."
                  },
                  "dylib": {
                    "type": "string",
                    "format": "binary",
                    "description": "Optional .dylib injection."
                  },
                  "tweaks": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary"
                    },
                    "description": "Legacy bot alias for up to two .deb/.dylib files."
                  },
                  "appName": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "app_name": {
                    "type": "string",
                    "description": "Alias for appName."
                  },
                  "bundleName": {
                    "type": "string",
                    "description": "Alias for appName."
                  },
                  "bundleId": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "bundle_id": {
                    "type": "string",
                    "description": "Alias for bundleId."
                  },
                  "bundleVersion": {
                    "type": "string",
                    "maxLength": 100
                  },
                  "bundle_version": {
                    "type": "string",
                    "description": "Alias for bundleVersion."
                  },
                  "version": {
                    "type": "string",
                    "description": "Alias for bundleVersion."
                  },
                  "injectExtensions": {
                    "type": "boolean",
                    "description": "Also inject dylibs into app extensions."
                  },
                  "signer": {
                    "type": "string",
                    "enum": [
                      "zsign"
                    ],
                    "default": "zsign"
                  }
                },
                "oneOf": [
                  {
                    "required": [
                      "ipa"
                    ]
                  },
                  {
                    "required": [
                      "ipaUrl"
                    ]
                  }
                ],
                "anyOf": [
                  {
                    "required": [
                      "p12"
                    ]
                  },
                  {
                    "required": [
                      "certificate"
                    ]
                  }
                ],
                "examples": [
                  {
                    "ipaUrl": "https://files.example.net/app.ipa",
                    "appName": "Example App",
                    "bundleId": "com.example.app",
                    "version": "1.2.3"
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Request validated and queued",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AcceptedJob"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "400": {
            "description": "Invalid or missing fields, unsupported signer, invalid file extension or invalid IPA URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "401": {
            "description": "API_CLIENTS_JSON is configured but X-API-Key is missing or invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "413": {
            "description": "One or more uploaded files exceed their configured size limit.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "429": {
            "description": "Anonymous source-IP limit, authenticated per-client quota, or authenticated per-IP safety ceiling exceeded. Authenticated client quota responses include code API_CLIENT_RATE_LIMITED, Retry-After, and X-API-Client quota headers.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "Tigris storage or job encryption is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        },
        "security": [
          {},
          {
            "apiKeyAuth": []
          }
        ]
      }
    },
