            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        }
      }
    },
    "/ota/{jobId}/{token}/manifest.plist": {
      "get": {
        "tags": [
          "Results"
        ],
        "summary": "Apple OTA manifest",
        "description": "Returns XML plist for the itms-services install flow. The embedded IPA download expires no later than the signed result.",
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OTA plist XML",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "404": {
            "description": "Link expired or unavailable.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "409": {
            "description": "Bundle ID missing.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "Manifest generation failed.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Runtime readiness",
        "responses": {
          "200": {
            "description": "Required runtime configuration exists.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "Required dependency missing.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        }
      }
    },
    "/api/v1/discord/health": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Discord bot health compatibility endpoint",
        "responses": {
          "200": {
            "description": "Signer ready.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "Service degraded.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        }
      }
    },
    "/healthz/dependencies": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Cached dependency diagnostic check",
        "description": "Runs bounded/cached diagnostics for zsign, Tigris bucket access, workspace writability, job encryption, and Redis when shared queue mode is enabled. Does not reveal credentials.",
        "responses": {
          "200": {
            "description": "All configured dependencies are reachable.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "One or more dependency checks failed.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        }
      }
    },
    "/api/ops/metrics": {
      "get": {
        "tags": [
          "Health"
        ],
        "summary": "Owner-only operational metrics",
        "description": "Restricted to the configured OWNER_IP. Reports queue depth, worker concurrency, process uptime, informational disk availability and result retention. Does not return secrets and does not enforce disk-based admission limits.",
        "responses": {
          "200": {
            "description": "Operational snapshot (disk statistics may be unavailable independently).",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean"
                    },
                    "service": {
                      "type": "string"
                    },
                    "timestamp": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "uptimeSeconds": {
                      "type": "integer"
                    },
                    "queue": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "disk": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "results": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "runtime": {
                      "type": "object",
                      "additionalProperties": true
                    },
                    "requestId": {
                      "type": "string",
                      "format": "uuid"
                    }
                  }
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "404": {
            "description": "Requester is not the configured documentation/owner IP.",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "Metrics aggregation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "jobBearer": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "jobToken"
      },
      "apiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "X-API-Key",
        "description": "Conditional: optional by default; required on signing submissions when API_CLIENTS_JSON is configured."
      }
    },
    "parameters": {
      "JobId": {
        "name": "jobId",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": false
          },
          "ok": {
            "type": "boolean",
            "const": false
          },
          "error": {
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Stable machine-readable error code."
          },
          "requestId": {
            "type": "string",
            "format": "uuid",
            "description": "Server-generated request correlation ID."
          }
        },
        "required": [
          "error"
        ]
      },
      "AcceptedJob": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "ok": {
            "type": "boolean",
            "const": true
          },
          "jobId": {
            "type": "string",
            "format": "uuid"
          },
          "job_id": {
            "type": "string"
          },
          "jobToken": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "const": "queued"
          },
          "stage": {
            "type": "string"
          },
          "progress": {
            "type": "number"
          },
          "message": {
            "type": "string"
          },
          "poll_after_ms": {
            "type": "integer"
          },
          "statusUrl": {
            "type": "string",
            "format": "uri"
          },
          "status_url": {
            "type": "string",
            "format": "uri"
          },
          "progressUrl": {
            "type": "string",
            "format": "uri"
          },
          "progress_url": {
            "type": "string",
            "format": "uri"
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          }
        },
        "required": [
          "success",
          "jobId",
          "jobToken",
          "statusUrl"
        ]
      },
      "JobStatus": {
        "type": "object",
        "properties": {
          "success": {
            "type": "boolean"
          },
          "ok": {
            "type": "boolean"
          },
          "id": {
            "type": "string"
          },
          "jobId": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "queued",
              "signing",
              "completed",
              "failed"
            ]
          },
          "phase": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          },
          "progress": {
            "type": "number",
            "minimum": 0,
            "maximum": 100
          },
          "poll_after_ms": {
            "type": "integer"
          },
          "message": {
            "type": "string"
          },
          "error": {
            "type": [
              "string",
              "null"
            ]
          },
          "logs": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "integer"
                },
                "at": {
                  "type": "integer"
                },
                "stream": {
                  "type": "string"
                },
                "message": {
                  "type": "string"
                }
              }
            }
          },
          "result": {
            "type": "object",
            "description": "Present when completed; includes downloadUrl/download_url and when Bundle ID is available manifestUrl/installUrl/otaUrl/ota_url."
          },
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "resultExpiresAt": {
            "type": "string",
            "format": "date-time",
            "description": "Signed-result deletion deadline, when completed."
          },
          "resultExpiresAtMs": {
            "type": "integer",
            "format": "int64"
          }
        }
      }
    },
    "headers": {
      "RequestIdHeader": {
        "description": "Server-generated request correlation ID. Include it with bug reports or support requests.",
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    }
  }
}
