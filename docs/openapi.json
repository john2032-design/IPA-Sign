    "/api/jobs/{jobId}": {
      "get": {
        "tags": [
          "Signing"
        ],
        "summary": "Poll job status and logs",
        "description": "Poll until completed or failed. Use the returned jobToken as a Bearer token. after is the last log sequence ID already received.",
        "security": [
          {
            "jobBearer": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "after",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Job state; completed API jobs include result",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobStatus"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "400": {
            "description": "Invalid job ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "404": {
            "description": "Job not found or job token invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "Job metadata is unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        }
      }
    },
    "/api/jobs/{jobId}/download-url": {
      "post": {
        "tags": [
          "Results"
        ],
        "summary": "Create temporary signed IPA download URL",
        "security": [
          {
            "jobBearer": []
          }
        ],
        "parameters": [
          {
            "name": "jobId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Download URL",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "url": {
                      "type": "string",
                      "format": "uri"
                    },
                    "expiresIn": {
                      "type": "integer"
                    },
                    "expiresAt": {
                      "type": "string",
                      "format": "date-time"
                    },
                    "expiresAtMs": {
                      "type": "integer",
                      "format": "int64"
                    }
                  },
                  "required": [
                    "url",
                    "expiresIn"
                  ]
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "400": {
            "description": "Invalid job ID.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "404": {
            "description": "Job not found or token invalid.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "409": {
            "description": "Job is not complete yet.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "410": {
            "description": "Signed IPA expired and was deleted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          },
          "503": {
            "description": "Could not create download URL.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            },
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/RequestIdHeader"
              }
            }
          }
        }
      }
    },
